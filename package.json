{
  "name": "@jakehemmerle/dsh-aris",
  "version": "0.2.0-alpha.1",
  "description": "ARIS research workflow as a DeepSeek Harness agent preset: 84 skills plus an in-harness reviewer from a different model family.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakehemmerle/dsh-aris-better.git"
  },
  "homepage": "https://github.com/jakehemmerle/dsh-aris-better/tree/dsh-next#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "aris",
    "research",
    "agent"
  ],
  "exports": {
    ".": "./dsh/index.mjs",
    "./client": "./dsh/client.js",
    "./skills": "./dsh/skills.mjs",
    "./reviewer": "./dsh/reviewer.mjs",
    "./scope-limits": "./dsh/scope-limits.mjs",
    "./bridge": "./dsh/bridge.mjs",
    "./cordis.patch.yml": "./dsh/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh/*.mjs",
    "dsh/client.js",
    "dsh/cordis.patch.yml",
    "dsh/SPEC.md",
    "skills",
    "tools",
    "templates",
    "mcp-servers",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test 'dsh/test/*.test.mjs'"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  }
}
